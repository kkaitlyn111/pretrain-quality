# Copy to config/cluster.env (git-ignored), edit, then `source config/cluster.env`.
# The SLURM scripts source it automatically (override the location with PQ_ENV=...).

# --- data locations ---------------------------------------------------------
export PQ_CORPUS_DIR=/path/to/Corpus-200B          # WebOrganizer/Corpus-200B checkout
export PQ_FEATURES_DIR=/path/to/pretrain-quality-data/features  # per-shard features, annotations.parquet
export PQ_WORK_DIR=/path/to/pretrain-quality-data/pipeline      # master.parquet, swarm runs, targets, EBMs
export PQ_MODELS_DIR=/path/to/pretrain-quality-data/models      # downloaded fastText / classifier weights
export PQ_LOGS_DIR="$PWD/logs"

# --- python -----------------------------------------------------------------
export PQ_PYTHON="$PWD/.venv/bin/python"

# --- caches -----------------------------------------------------------------
export HF_HOME=/path/to/cache/huggingface
export TORCHINDUCTOR_CACHE_DIR=/path/to/cache/torchinductor
export WANDB_DIR=/path/to/cache/wandb
# W&B is optional. Never commit a key: export WANDB_API_KEY in your shell
# (or run `wandb login`), or pass --no-wandb to the training scripts.

# --- SLURM (read by sbatch itself) ------------------------------------------
export SBATCH_ACCOUNT=your-account
export SBATCH_PARTITION=your-gpu-partition
export PQ_CPU_PARTITION=your-cpu-partition         # used via: sbatch -p "$PQ_CPU_PARTITION"
